# Copy to .env.local for local development. Never commit real values.
# docs/CONFIGURATION.md explains where to obtain each value.

# ---- Browser (bundled into the dashboard; must NOT contain secrets) ----
# Supabase > Project Settings > API: project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase > Project Settings > API Keys: publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Server only (Vercel functions) ----
APP_ENV=development
APP_BASE_URL=http://localhost:5173

SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase > Project Settings > API Keys: secret key (sb_secret_...). Bypasses RLS.
SUPABASE_SECRET_KEY=

OPENAI_API_KEY=
# A model id that supports the Responses API and function calling.
OPENAI_MODEL=

# Meta App > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# A random string you choose; enter the same value in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Meta App > App settings > Basic > App secret
WHATSAPP_APP_SECRET=
# Graph API version, format vNN.N. Check Meta's Graph API changelog for the latest.
WHATSAPP_API_VERSION=

# Random value (>= 32 chars), e.g. `openssl rand -hex 32`. Vercel Cron sends it
# as a bearer token to /api/jobs/process-events.
CRON_SECRET=
